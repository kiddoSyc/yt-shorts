# Copy this file to .env and fill in values. Never commit .env.

# --- App ---
APP_ENV=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# --- Storage ---
DATA_DIR=data
LOG_DIR=logs

# --- AI provider (moment detection) ---
AI_PROVIDER=gemini
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# If a model returns "not found"/quota errors, try gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.8-flash

# --- Clip length (optional; seconds) ---
CLIP_MIN_SECONDS=15
CLIP_MAX_SECONDS=60

# --- Sessions / clip length (seconds) ---
CLIP_DURATION_DEFAULT=60
CLIP_DURATION_MIN=15
CLIP_DURATION_MAX=180
CLIP_LENGTH_TOLERANCE=0.2
MAX_MOMENTS=5

# --- Transcript source: auto (YouTube captions, else audio-only + Whisper) | captions | whisper ---
TRANSCRIPT_SOURCE=auto

# --- Download (keep low to save bandwidth) ---
MAX_VIDEO_HEIGHT=720

# --- Whisper (model downloads once, on the first transcription run; tiny = lightest, base = default, small = better accuracy) ---
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_VAD_FILTER=true

# --- FFmpeg ---
FFMPEG_PATH=ffmpeg

# --- Video encode quality (raw clip + final Short) ---
# Lower = higher quality/bigger files (17 is close to visually lossless; 23 is typical web quality)
VIDEO_CRF=17
# veryfast < fast < medium < slow (slower = better compression at the same quality, but takes longer)
VIDEO_PRESET=fast

# --- Vertical Shorts formatting (final output, 9:16) ---
SHORTS_WIDTH=1080
SHORTS_HEIGHT=1920

# --- Burned-in captions ---
CAPTIONS_ENABLED=true
CAPTION_FONT_NAME=DejaVu Sans
CAPTION_FONT_SIZE=64
CAPTION_MAX_CHARS_PER_LINE=21
CAPTION_MAX_LINES=2
# Distance from the bottom edge (px, at 1080x1920) so captions clear on-screen UI
CAPTION_MARGIN_V=260
